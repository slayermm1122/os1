# Copy to .env if you want server-side fallback keys.
# For normal local use, the web UI stores user-provided keys in browser localStorage.

# ElevenLabs. API key is optional here; the UI will ask for it.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MALE_VOICE_ID=
ELEVENLABS_FEMALE_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_REALTIME_STT_MODEL=scribe_v2_realtime
ELEVENLABS_REALTIME_STT_AUDIO_FORMAT=pcm_16000
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STREAM_OUTPUT_FORMAT=pcm_16000
# Optional ISO language hint, for example: en, zh
ELEVENLABS_STT_LANGUAGE_CODE=

# LLM. API key is optional here; the UI will ask for it.
LLM_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.5
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=700

# Agent
SYSTEM_PROMPT=你是一个语音客服 agent。回答要简短、自然、准确；如果参考资料不足，直接说明不确定。
MAX_HISTORY_TURNS=8

# Local safety limits.
MAX_UPLOAD_BYTES=26214400
MAX_CHAT_CHARS=8000
MAX_TTS_CHARS=4000
MAX_SESSIONS=200
SESSION_TTL_SECONDS=3600
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_READ_TIMEOUT_SECONDS=90
UPSTREAM_WRITE_TIMEOUT_SECONDS=30
UPSTREAM_POOL_TIMEOUT_SECONDS=10
UPSTREAM_STREAM_TIMEOUT_SECONDS=120

# Keyword knowledge search. Disabled for the first pass.
KNOWLEDGE_ENABLED=false
KNOWLEDGE_DOCS_DIR=knowledge_docs
KNOWLEDGE_DB_PATH=data/knowledge.sqlite
KNOWLEDGE_LIMIT=4
