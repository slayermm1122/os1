# Copy to .env before starting OS1. This is the only persistent settings source.
# The browser never receives or stores provider API keys.

# ElevenLabs. The key needs TTS/STT, voices_read, and user_read permissions.
ELEVENLABS_API_KEY=
# Active TTS voice. Selecting a voice in OS1 updates this local value.
ELEVENLABS_VOICE_ID=
# Automatically updated to en or zh when a voice is selected in OS1.
ELEVENLABS_VOICE_LANGUAGE=en
# Legacy defaults shown when the library cannot be loaded.
ELEVENLABS_MALE_VOICE_ID=
ELEVENLABS_FEMALE_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_REALTIME_STT_MODEL=scribe_v2_realtime
ELEVENLABS_REALTIME_STT_AUDIO_FORMAT=pcm_16000
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
TTS_PROVIDER=elevenlabs
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STREAM_OUTPUT_FORMAT=pcm_16000
# Enterprise only: set false when ElevenLabs Zero Retention Mode is enabled for the account.
ELEVENLABS_ENABLE_LOGGING=true
# Optional ISO language hint, for example: en, zh
ELEVENLABS_STT_LANGUAGE_CODE=
# Realtime STT end-of-speech: vad (Voice Activity Detection) or manual
ELEVENLABS_STT_COMMIT_STRATEGY=vad
ELEVENLABS_STT_VAD_THRESHOLD=0.4
ELEVENLABS_STT_VAD_SILENCE_THRESHOLD_SECS=1.2
ELEVENLABS_STT_VAD_MIN_SPEECH_DURATION_MS=100
ELEVENLABS_STT_VAD_MIN_SILENCE_DURATION_MS=100
ASSISTANT_NAME=
USER_NAME=
# Conversation style: default, concise, or conversational.
ASSISTANT_PERSONA=default

# LLM. Configure one server-side key; it is never sent to the browser.
LLM_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.5
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=700

# Agent
# Short spoken chat replies for TTS — conversation, not a monologue.
SYSTEM_PROMPT=You are OS1, a concise voice assistant in a live voice conversation. Every response is sent directly to text-to-speech. Write only the words that should be spoken aloud. Answer directly in the required conversational language with short complete sentences and ordinary punctuation. Spell out numbers, dates, times, currencies, measurements, abbreviations, symbols, shortcuts, and URLs in natural spoken form. Never output markdown, lists, code, XML, SSML, audio tags, stage directions, emojis, citations, decorative symbols, or text not meant to be spoken.

# Local turn telemetry. Full user/model text is stored in this ignored SQLite file.
TELEMETRY_ENABLED=true
TELEMETRY_DB_PATH=data/telemetry.sqlite
TELEMETRY_QUEUE_SIZE=2048

# Local safety limits.
MAX_UPLOAD_BYTES=26214400
MAX_HTTP_BODY_BYTES=31457280
MAX_CHAT_CHARS=8000
MAX_TTS_CHARS=4000
MAX_SESSIONS=200
SESSION_TTL_SECONDS=3600
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_READ_TIMEOUT_SECONDS=90
UPSTREAM_WRITE_TIMEOUT_SECONDS=30
UPSTREAM_POOL_TIMEOUT_SECONDS=10
UPSTREAM_STREAM_TIMEOUT_SECONDS=120
PROVIDER_CHECK_TIMEOUT_SECONDS=6
