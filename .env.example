# Copy to .env before starting OS1. This is the only persistent settings source.
# The browser never receives or stores provider API keys.

# ElevenLabs. The key needs TTS/STT, voices_read, and user_read permissions.
ELEVENLABS_API_KEY=
# Active TTS voice. Selecting a voice in OS1 updates this local value.
ELEVENLABS_VOICE_ID=
# Reply mode: auto follows Scribe's per-turn English/Chinese detection.
ASSISTANT_RESPONSE_LANGUAGE=auto
# Legacy defaults shown when the library cannot be loaded.
ELEVENLABS_MALE_VOICE_ID=
ELEVENLABS_FEMALE_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_REALTIME_STT_MODEL=scribe_v2_realtime
ELEVENLABS_REALTIME_STT_AUDIO_FORMAT=pcm_16000
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
TTS_PROVIDER=elevenlabs
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STREAM_OUTPUT_FORMAT=pcm_16000
# Enterprise only: set false when ElevenLabs Zero Retention Mode is enabled for the account.
ELEVENLABS_ENABLE_LOGGING=true
# Scribe prompting managed by Pronunciation in the OS1 sidebar.
ELEVENLABS_STT_KEYTERMS_JSON=[]
# The OS1-managed ElevenLabs alias dictionary and its current immutable version.
ELEVENLABS_PRONUNCIATION_DICTIONARY_ID=
ELEVENLABS_PRONUNCIATION_DICTIONARY_VERSION_ID=
# Realtime STT end-of-speech: vad (Voice Activity Detection) or manual
ELEVENLABS_STT_COMMIT_STRATEGY=vad
ELEVENLABS_STT_VAD_THRESHOLD=0.4
ELEVENLABS_STT_VAD_SILENCE_THRESHOLD_SECS=1.2
ELEVENLABS_STT_VAD_MIN_SPEECH_DURATION_MS=100
ELEVENLABS_STT_VAD_MIN_SILENCE_DURATION_MS=100
ASSISTANT_NAME=
ASSISTANT_NAME_PRONUNCIATION=
USER_NAME=
USER_NAME_PRONUNCIATION=
# Conversation style: default, concise, or conversational.
ASSISTANT_PERSONA=default

# Brain models. Selection in the OS1 sidebar updates LLM_PROVIDER.
LLM_PROVIDER=xai
# Grok (xAI), low reasoning.
LLM_API_KEY=
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.5
LLM_REASONING_EFFORT=low
# DeepSeek V4 Flash, thinking disabled.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
# Google AI Studio Gemini, minimal thinking through the Interactions API.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
GOOGLE_AI_PROJECT=
GOOGLE_AI_PROJECT_NUMBER=
# Shared generation bounds. Gemini 3.5 Flash-Lite ignores temperature.
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=700

# Agent
# Short spoken chat replies for TTS — conversation, not a monologue.
SYSTEM_PROMPT=You are an artificial-intelligence voice assistant in a live voice conversation. Be transparent that you are AI, and never claim or imply that you are human. Every response is sent directly to text-to-speech, so output only one continuous paragraph containing the words that should be spoken aloud. Follow the explicit response-language instruction at the end of the latest user message. Answer the user directly and start with the answer. Use short, complete sentences and ordinary punctuation. Most replies should be one to three sentences unless the user asks for detail. Treat the following as strict output requirements for a text-to-speech script. Everything other than necessary punctuation for short sentences must be readable spoken text. Spell out numbers, ordinals, dates, times, currencies, percentages, measurements, abbreviations, keyboard shortcuts, symbols, and URLs in natural spoken form. Expand ambiguous abbreviations. Prefer familiar words and contractions. Use periods, commas, and question marks to create a calm natural rhythm. Avoid excessive ellipses, repeated punctuation, and all-caps emphasis. Never output markdown, headings, bullet points, numbered lists, tables, code blocks, raw code, XML, SSML, audio tags, stage directions, emojis, citations, or decorative symbols. Do not describe how the response should sound. Do not include any text that is not meant to be spoken.

# Local usage telemetry. Token, audio, character, timing, model, and status metrics only;
# conversation content is not written to this ignored SQLite file.
TELEMETRY_ENABLED=true
TELEMETRY_DB_PATH=data/telemetry.sqlite
TELEMETRY_QUEUE_SIZE=2048
CHAT_HISTORY_PATH=data/chat_history.jsonl

# Local safety limits.
MAX_UPLOAD_BYTES=26214400
MAX_HTTP_BODY_BYTES=31457280
MAX_CHAT_CHARS=8000
MAX_TTS_CHARS=4000
MAX_SESSIONS=200
SESSION_TTL_SECONDS=3600
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_READ_TIMEOUT_SECONDS=90
UPSTREAM_WRITE_TIMEOUT_SECONDS=30
UPSTREAM_POOL_TIMEOUT_SECONDS=10
UPSTREAM_STREAM_TIMEOUT_SECONDS=120
PROVIDER_CHECK_TIMEOUT_SECONDS=6
